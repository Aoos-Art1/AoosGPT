# Copy to .env.local for local development. Keep real secrets out of git.
APP_ORIGIN=http://localhost:3000
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Production: enable only behind an ingress that overwrites X-Aoos-Client-IP
# with one client IP and prevents direct access to Next.js. XFF is not trusted.
TRUST_PROXY_HEADERS=false

# Docker Compose only: generate distinct hexadecimal passwords (24+ characters).
DB_OWNER_PASSWORD=
DB_RUNTIME_PASSWORD=

# Required only to activate real AI features. No model is silently chosen.
AI_API_KEY=
AI_MODEL=
AI_TRANSCRIPTION_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Azure Speech voice: ar-SA-HamedNeural (Saudi Arabic).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
